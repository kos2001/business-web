# hermes-gateway — 계약서 분석·고객관리 워크스페이스가 사용합니다.
# HERMES_GATEWAY_KEY 는 ~/gitspace/AIFde/.env 의 GATEWAY_CLIENT_KEYS 첫 값입니다.
# 절대 NEXT_PUBLIC_ 접두어를 붙이지 마세요 — 브라우저로 유출됩니다.
HERMES_GATEWAY_URL=http://127.0.0.1:8700
HERMES_GATEWAY_KEY=

# mi-report 백엔드 — MI 리포트 워크스페이스가 사용합니다 (~/gitspace/mi-report).
MI_REPORT_URL=http://127.0.0.1:8000
# mi-report 는 userId 로 세션·장기메모리를 분리합니다. business-web 에 로그인이
# 붙기 전까지는 전원이 이 하나의 스코프를 공유합니다.
MI_REPORT_USER_ID=business-web

# marketing-agent 백엔드 — 영업 현황진단 워크스페이스가 사용합니다
# (~/gitspace/marketing-agent).
MARKETING_AGENT_URL=http://127.0.0.1:8012

# ── SSO (OIDC) ────────────────────────────────────────────────────────────
# 넷 다 비우면 로그인이 꺼지고 앱은 이전처럼 누구나 접근할 수 있습니다.
# 설정하는 순간 미들웨어가 모든 경로를 막고 인가 목록이 적용됩니다.
#
# Entra ID  : https://login.microsoftonline.com/<tenant-id>/v2.0
# Google    : https://accounts.google.com
# Keycloak  : https://<host>/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
# 공개 클라이언트(PKCE 단독)면 비워 둡니다.
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3100/api/auth/callback
# 기본값 "openid email profile". 이메일 클레임이 없으면 인가할 수 없습니다.
OIDC_SCOPE=

# 세션 쿠키 서명 키. 32자 이상이어야 하며 기본값이 없습니다 —
# 코드에 박힌 폴백 키는 서명이 없는 것과 같습니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── 인가 목록 ──────────────────────────────────────────────────────────────
# 최초 관리자. 목록이 비어 있어도 이 주소는 관리자로 들어올 수 있습니다.
# 없으면 아무도 첫 권한을 부여할 수 없습니다(문이 잠기고 열쇠가 안에 있는 상태).
# 실제 관리자를 설정 화면에서 추가한 뒤 지우세요. 쉼표로 구분합니다.
ACCESS_BOOTSTRAP_ADMINS=
# 목록 파일 위치. 기본값 ~/.hermes/business-web-access.json
ACCESS_LIST_PATH=

# 문서 파싱·선례 코퍼스 (~/gitspace/docparser 사용)
DOCPARSER_DIR=/Users/kos2001/gitspace/docparser
# 계약 선례 인덱스. docparser 기본 인덱스(하드웨어 데이터시트)와 반드시 분리합니다.
CONTRACT_CORPUS_DIR=/Users/kos2001/.hermes/business-web-corpus

# ── Confluence (선택) ────────────────────────────────────────────────────────
# 계약서가 파일이 아니라 위키 페이지로 오는 경우를 위한 설정.
# 화면에서 확인·시험해 볼 수 있다: 앱의 "설정 > Confluence 연결".
#
# 서버에서만 읽는다 — NEXT_PUBLIC_ 접두사를 붙이면 토큰이 브라우저 번들에 실린다.
#
# BASE_URL 은 페이지 주소가 아니라 위키의 뿌리 주소다. 여기 적힌 호스트와 정확히
# 같은 주소만 읽으므로 다른 사이트 주소는 거부된다.
#
# 인증 방식은 EMAIL 유무로 갈린다. 틀리면 401 이 나는데 원인이 안 보이므로 주의:
#
#   Atlassian Cloud (*.atlassian.net) — 이메일 + API 토큰
#     CONFLUENCE_BASE_URL=https://회사.atlassian.net/wiki
#     CONFLUENCE_EMAIL=you@company.com
#     CONFLUENCE_API_TOKEN=...   # id.atlassian.com/manage-profile/security/api-tokens
#
#   사내 서버 (Data Center) — Personal Access Token 만. EMAIL 은 비워 둔다
#     CONFLUENCE_BASE_URL=https://wiki.회사.com
#     CONFLUENCE_API_TOKEN=...   # Confluence 프로필 > 개인 액세스 토큰
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# ── Obsidian 노트 (선택) ─────────────────────────────────────────────────────
# 계약 검토 결과를 보관함에 노트로 남긴다. 경로가 실제로 있어야 답변 아래에
# "노트로 저장" 이 나타나고, 없으면 조용히 숨는다.
# 화면에서 확인: 앱의 "설정 > Obsidian 노트".
#
# 노트는 보관함 안의 NOTE_FOLDER 에만 쓰인다. 보관함에서 읽어오지는 않는다 —
# 계약서는 선례 코퍼스가 갖고 있고, 같은 문서를 두 곳에서 읽으면 어긋난다.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_NOTE_FOLDER=영업 에이전트
